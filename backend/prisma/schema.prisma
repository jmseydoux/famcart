generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Household {
  id          String   @id @default(uuid())
  name        String
  invite_code String   @unique @default(uuid())
  created_at  DateTime @default(now())

  users     User[]
  suppliers Supplier[]
  lists     ShoppingList[]
  sessions  ShoppingSession[]
}

model User {
  id           String   @id @default(uuid())
  supabase_id  String   @unique
  email        String   @unique
  name         String
  household_id String?
  created_at   DateTime @default(now())

  household       Household?        @relation(fields: [household_id], references: [id])
  created_lists   ShoppingList[]
  requested_items ShoppingItem[]
  sessions        ShoppingSession[]
}

model Supplier {
  id           String @id @default(uuid())
  name         String
  household_id String

  household Household      @relation(fields: [household_id], references: [id])
  lists     ShoppingList[]

  @@unique([name, household_id])
}

model ShoppingList {
  id           String     @id @default(uuid())
  household_id String
  created_by   String
  supplier_id  String?
  status       ListStatus @default(OPEN)
  created_at   DateTime   @default(now())
  closed_at    DateTime?

  household Household       @relation(fields: [household_id], references: [id])
  creator   User            @relation(fields: [created_by], references: [id])
  supplier  Supplier?       @relation(fields: [supplier_id], references: [id])
  items     ShoppingItem[]
  sessions  ShoppingSession[]
}

model ShoppingItem {
  id           String     @id @default(uuid())
  name         String
  quantity     Float      @default(1)
  unit         String?
  status       ItemStatus @default(PENDING)
  list_id      String
  requested_by String
  created_at   DateTime   @default(now())

  list          ShoppingList    @relation(fields: [list_id], references: [id])
  requester     User            @relation(fields: [requested_by], references: [id])
  session_items SessionItem[]
}

model ShoppingSession {
  id           String    @id @default(uuid())
  list_id      String
  household_id String
  shopper_id   String
  started_at   DateTime  @default(now())
  ended_at     DateTime?

  list      ShoppingList  @relation(fields: [list_id], references: [id])
  household Household     @relation(fields: [household_id], references: [id])
  shopper   User          @relation(fields: [shopper_id], references: [id])
  items     SessionItem[]
}

model SessionItem {
  id         String            @id @default(uuid())
  session_id String
  item_id    String
  status     SessionItemStatus
  note       String?

  session ShoppingSession @relation(fields: [session_id], references: [id])
  item    ShoppingItem    @relation(fields: [item_id], references: [id])
}

enum ListStatus {
  OPEN
  CLOSED
}

enum ItemStatus {
  PENDING
  BOUGHT
  UNAVAILABLE
}

enum SessionItemStatus {
  BOUGHT
  UNAVAILABLE
  SKIPPED
}
